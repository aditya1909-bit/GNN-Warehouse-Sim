\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Warm-start behavior cloning convergence. The behavior cloning loss decreases only modestly, while teacher action match approaches 1.0 very quickly. This supports the later conclusion that the policy remained too close to the heuristic teacher.}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:warm-start}{{1}{5}{Warm-start behavior cloning convergence. The behavior cloning loss decreases only modestly, while teacher action match approaches 1.0 very quickly. This supports the later conclusion that the policy remained too close to the heuristic teacher}{figure.1}{}}
